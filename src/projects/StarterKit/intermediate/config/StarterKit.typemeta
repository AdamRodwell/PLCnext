<?xml version="1.0" encoding="utf-8"?>
<MetaConfigurationDocument xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" schemaVersion="2.0" xmlns="http://www.phoenixcontact.com/schema/metaconfig">
  <Types>
    <Struct type="StarterKitCommand">
      <Fields>
        <Field name="readAnalog1" type="boolean" attributes="" dimensions="" />
        <Field name="setOutput" type="boolean" attributes="" dimensions="" />
      </Fields>
    </Struct>
    <Struct type="StarterKitConfig">
      <Fields>
        <Field name="allowOutputs" type="boolean" attributes="" dimensions="" />
        <Field name="minRange" type="uint32" attributes="" dimensions="" />
        <Field name="analogInOne" type="analogConfig" attributes="" dimensions="" />
      </Fields>
    </Struct>
    <Struct type="StarterKitData">
      <Fields>
        <Field name="areOutPutActive" type="boolean" attributes="" dimensions="" />
      </Fields>
    </Struct>
    <Struct type="TemplateConfig">
      <Fields>
        <Field name="exampleTimeoutMs" type="uint32" attributes="" dimensions="" />
        <Field name="examplePositionMm" type="float32" attributes="" dimensions="" />
        <Field name="exampleIgnoreSensor" type="boolean" attributes="" dimensions="" />
      </Fields>
    </Struct>
    <Struct type="TemplateData">
      <Fields>
        <Field name="isInitialisationDone" type="boolean" attributes="" dimensions="" />
        <Field name="isCycleDone" type="boolean" attributes="" dimensions="" />
        <Field name="cycleCount" type="uint32" attributes="" dimensions="" />
        <Field name="currentState" type="TemplateControllerState" attributes="" dimensions="" />
        <Field name="error" type="TemplateControllerError" attributes="" dimensions="" />
      </Fields>
    </Struct>
    <Struct type="TemplateControllerError">
      <Fields>
        <Field name="warningExampleTimeout" type="boolean" attributes="" dimensions="" />
        <Field name="warningExampleSensorFailed" type="boolean" attributes="" dimensions="" />
        <Field name="errorExampleUnexpectedState" type="boolean" attributes="" dimensions="" />
        <Field name="hasErrorSubSystem" type="boolean" attributes="" dimensions="" />
        <Field name="hasWarningSubSystem" type="boolean" attributes="" dimensions="" />
      </Fields>
    </Struct>
    <Struct type="TemplateCommand">
      <Fields>
        <Field name="disable" type="boolean" attributes="" dimensions="" />
        <Field name="initialise" type="boolean" attributes="" dimensions="" />
        <Field name="startCycle" type="boolean" attributes="" dimensions="" />
        <Field name="enterManualMode" type="boolean" attributes="" dimensions="" />
        <Field name="manual" type="TemplateManualCommand" attributes="" dimensions="" />
      </Fields>
    </Struct>
    <Struct type="analogConfig">
      <Fields>
        <Field name="minRange" type="uint32" attributes="" dimensions="" />
        <Field name="maxRange" type="uint32" attributes="" dimensions="" />
      </Fields>
    </Struct>
    <Struct type="TemplateManualCommand">
      <Fields>
        <Field name="activateOutput" type="boolean" attributes="" dimensions="" />
        <Field name="manualSetpoint" type="float32" attributes="" dimensions="" />
      </Fields>
    </Struct>
    <Enumeration type="TemplateControllerState" baseType="uint8">
      <Symbols>
        <Symbol name="DISABLED" value="0"/>
        <Symbol name="INITIALISING" value="1"/>
        <Symbol name="IDLE" value="2"/>
        <Symbol name="MANUAL_MODE" value="254"/>
        <Symbol name="ERROR" value="255"/>
      </Symbols>
    </Enumeration>
  </Types>
</MetaConfigurationDocument>